{
	"name": "svelte-theme",
	"version": "0.0.1",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"prepare": "vp config && svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"lint": "eslint .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && vp test",
		"ready": "vp check && vp run lint && vp run check && vp run test"
	},
	"dependencies": {
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "catalog:",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^3.1.0"
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=22.22.1"
	}
}
