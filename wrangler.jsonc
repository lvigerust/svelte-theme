// Hosts the prerendered sandbox (`pnpm build` writes it to build/) on Cloudflare Workers as
// static assets, with no Worker script. Workers Builds deploys it on every push to main; the
// Worker's name in the dashboard must match `name`.
{
	"name": "svelte-theme",
	"compatibility_date": "2026-10-11",
	"assets": {
		"directory": "./build"
	}
}
